tr:nth-child(even) { background-color: #f8fafc; }
pre { background-color: #1e293b; color: #f8fafc; padding: 15px; border: 1px solid #cbd5e1; font-family: 'Consolas', 'Courier New', monospace; font-size: 12px; margin: 10px 0; }
